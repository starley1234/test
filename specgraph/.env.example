# По умолчанию SQLite — uvicorn стартует без Postgres.
DATABASE_URL=sqlite:///./specgraph.db
# Если поднят docker compose db:
# DATABASE_URL=postgresql+psycopg://specgraph:specgraph@localhost:5432/specgraph
# SQLITE_FALLBACK=true   — если Postgres недоступен, не падать, а взять SQLite

TIKA_SERVER_URL=http://localhost:9998
UPLOAD_DIR=./data/uploads
MEDIA_DIR=./data/media

# --- 1. Дешёвая модель (суммаризация, сжатие контекста) ---
CHEAP_BASE_URL=https://api.openai.com/v1
CHEAP_API_KEY=
CHEAP_MODEL=gpt-4o-mini

# --- 2. Дорогая модель (сложные решения: валидация, противоречия) ---
EXPENSIVE_BASE_URL=https://api.openai.com/v1
EXPENSIVE_API_KEY=
EXPENSIVE_MODEL=gpt-4o

# --- 3. Эмбеддинги ---
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- 4. VLM (принципиальные схемы) ---
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=gpt-4o
