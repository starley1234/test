# ── WenAGI Gateway ────────────────────────────────────────────────────────────
# Copy to .env and adjust. Never commit the real .env.

# HTTP port for the gateway + landing
PORT=8080

# Where the demo ledger lives (atomic JSON, survives restarts)
WAGI_STATE_FILE=data/state.json

# Demo credits for new API keys and faucet top-ups (in $WAGI)
STARTING_BALANCE=1000
FAUCET_AMOUNT=250

# Optional: proxy "real/*" models to an OpenAI-compatible upstream.
# Users still pay in $WAGI; the gateway converts and settles on-chain.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# On-chain settlement (fill after deploying contracts, see contracts/scripts)
# WAGI_TOKEN_ADDRESS=0x...
# INFERENCE_MARKET_ADDRESS=0x...
# RELAYER_PRIVATE_KEY=0x...   # operational key of RelayerMultisig (2/3);
#                             # rotated by the multisig via setRelayer()
# RPC_URL=https://mainnet.base.org
